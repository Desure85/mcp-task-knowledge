# mcp-task-knowledge — production env example
# Copy to .env or export explicitly. No dotenv autoload — pass via `docker run -e` / compose environment.

# ── Required ──
DATA_DIR=/data

# ── Transport (required for Docker/K8s) ──
MCP_TRANSPORT=http
MCP_PORT=3001
MCP_HOST=0.0.0.0

# ── Data layout (optional) ──
CURRENT_PROJECT=mcp
# MCP_TASK_DIR=/data/tasks
# MCP_KNOWLEDGE_DIR=/data/knowledge
# MCP_PROMPTS_DIR=/data/prompts
# OBSIDIAN_VAULT_ROOT=/data/obsidian

# ── Embeddings (optional, graceful fallback to none/BM25) ──
EMBEDDINGS_MODE=none
# EMBEDDINGS_MODEL_PATH=/app/models/encoder.onnx
# EMBEDDINGS_DIM=768
# EMBEDDINGS_CACHE_DIR=/data/.embeddings

# ── Auth (set for any non-local deploy) ──
# JWT_SECRET=change-me
# MCP_RATE_LIMIT_ENABLED=true

# ── Observability ──
# LOG_LEVEL=info
# METRICS_ENABLED=false
